{
  "name": "tauros-nea-bot",
  "version": "1.0.0",
  "description": "TAUROS AI Assistant - React Native app with Telegram bot integration",
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo build",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "eject": "expo eject",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "jarbot": "python3 core_jarbot.py",
    "jarbot:start": "./start_jarbot.sh"
  },
  "dependencies": {
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "axios": "^1.6.2",
    "expo": "~49.0.15",
    "expo-status-bar": "~1.6.0",
    "react": "18.2.0",
    "react-native": "0.72.10",
    "react-native-safe-area-context": "4.6.3",
    "react-native-screens": "~3.22.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@types/react": "~18.2.14",
    "@types/react-native": "~0.72.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-preset-expo": "^13.2.3",
    "eslint": "^8.0.0",
    "eslint-config-expo": "^7.0.0",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.2.1",
    "typescript": "^5.1.3"
  },
  "jest": {
    "preset": "react-native"
  },
  "private": true,
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "react-native",
    "expo",
    "typescript",
    "ai-assistant",
    "telegram-bot",
    "mobile-app"
  ],
  "author": "NEA Bot Development Team",
  "license": "MIT"
}
